{
  "name": "argus",
  "version": "2.0.0",
  "description": "Browser fingerprinting library for fraud and bot detection",
  "main": "dist/argus.esm.js",
  "module": "dist/argus.esm.js",
  "browser": "dist/argus.iife.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/argus.esm.js",
      "require": "./dist/argus.esm.js",
      "browser": "./dist/argus.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node server.js",
    "dev": "rollup --config rollup.config.mjs -w & nodemon -d 3 ./server.js localhost 8000",
    "build:wasm": "./scripts/build-wasm.sh",
    "build": "rollup --config rollup.config.mjs",
    "build:prod": "rollup --config rollup.config.mjs && npm run minify",
    "build:all": "npm run build:wasm && npm run build",
    "minify": "terser dist/argus.esm.js -o dist/argus.esm.min.js --source-map && terser dist/argus.iife.js -o dist/argus.iife.min.js --source-map",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "baseline:capture": "node scripts/capture-baseline.js",
    "baseline:compare": "node scripts/compare-fingerprint.js",
    "update:features": "npx tsx scripts/update-features-mdn.ts",
    "update:features:local": "npx tsx scripts/update-features.ts",
    "update:timezones": "npx tsx scripts/update-timezones.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrahamjuliot/CreepJS.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abrahamjuliot/CreepJS/issues"
  },
  "homepage": "https://github.com/abrahamjuliot/CreepJS#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.18.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.21.2",
    "happy-dom": "^20.0.11",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.9",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "prettier": "3.4.2",
    "rollup": "^4.30.1",
    "terser": "^5.37.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.16"
  }
}
